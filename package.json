{
  "name": "portafolio-luis-romero",
  "version": "1.0.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npx serve -l 5502 .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:edge": "deno test --config supabase/functions/deno.json --allow-env --allow-net supabase/functions/chat/chat.test.ts",
    "test:db": "supabase test db --local",
    "test:e2e": "deno test --config supabase/functions/deno.json --allow-env --allow-net supabase/functions/chat/e2e.test.ts",
    "test:all": "npm run test && npm run test:edge && npm run test:db",
    "ingest": "deno run --allow-read --allow-net --allow-env scripts/ingest.ts",
    "seed:availability": "deno run --allow-net --allow-env scripts/seed-availability.ts",
    "seed:contact": "deno run --allow-net --allow-env scripts/seed-contact.ts",
    "dedupe": "deno run --allow-net --allow-env scripts/dedupe-documents.ts",
    "deploy:chat": "supabase functions deploy chat --project-ref dsrxcqjivhvhvpqumcvb --no-verify-jwt",
    "deploy:embed": "supabase functions deploy embed --project-ref dsrxcqjivhvhvpqumcvb",
    "db:migrate": "supabase db push --project-ref dsrxcqjivhvhvpqumcvb"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.12",
    "fast-check": "^3.20.0",
    "jsdom": "^24.1.0",
    "vitest": "^4.1.12"
  }
}
