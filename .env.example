# ─── Portfolio Conversational Agent — Environment Variables ──────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
#
# All services used here have a FREE tier — no credit card needed.
# Setup guide: CHAT_AGENT_SETUP.md

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Groq (free tier — no credit card) ───────────────────────────────────────
# Get your key at: https://console.groq.com
# Models used: openai/gpt-oss-120b (primary), openai/gpt-oss-20b (fallback)

GROQ_API_KEY=gsk_...

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the Edge Function.
# localhost is always allowed in development automatically.
# Production example: https://your-portfolio.vercel.app

ALLOWED_ORIGINS=https://YOUR_PORTFOLIO_DOMAIN.vercel.app
